# === apps/web (Next.js, Vercel) ===
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000

# === apps/realtime (Fastify + Socket.IO, Railway) ===
REALTIME_PORT=4000
REALTIME_CORS_ORIGIN=http://localhost:3000
# Quando true, selectTracksForGame() pula chamada Deezer e usa só tracks já cacheadas no banco.
# Útil em dev sem internet ou pra CI.
SOMS_OFFLINE=false

# === Banco (Neon Postgres) ===
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# === Redis (Upstash) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Providers de música ===
DEEZER_APP_ID=
DEEZER_APP_SECRET=
