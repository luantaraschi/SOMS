{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@soms/db": ["./packages/db/src/index.ts"],
      "@soms/db/*": ["./packages/db/src/*"],
      "@soms/deezer": ["./packages/deezer/src/index.ts"],
      "@soms/deezer/*": ["./packages/deezer/src/*"],
      "@soms/shared": ["./packages/shared/src/index.ts"],
      "@soms/shared/*": ["./packages/shared/src/*"],
      "@soms/design-system/*": ["./packages/design-system/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build"]
}
